# ===================================================================
# 데이터베이스 (Supabase)
# ===================================================================
# Supabase 대시보드 → Settings → Database → Connection string
#
# Transaction mode (포트 6543) — 일반 API 요청용
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
#
# Session mode (포트 5432) — prisma db push / migrate 전용
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ===================================================================
# JWT 인증
# ===================================================================
# 최소 32자 이상의 랜덤 문자열 (운영 시 반드시 강력한 값으로 교체)
# 생성 예시: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-here

# ===================================================================
# Supabase Storage — 채팅 첨부 파일/이미지 (docs/chat/01-decisions.md §16)
# ===================================================================
# Supabase 대시보드 → Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
# **service_role secret** (anon key 아님). 클라이언트엔 절대 노출 X — backend 전용
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
# 사전에 Storage에서 **private 버킷**으로 생성 필요
SUPABASE_STORAGE_BUCKET=chat-attachments

# ===================================================================
# Resend 이메일 발송
# ===================================================================
# Resend 대시보드(resend.com) → API Keys에서 발급
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 발신자 이메일 (기본값: onboarding@resend.dev, 테스트 전용)
# 프로덕션: Resend에서 도메인 인증 후 noreply@yourdomain.com 형태로 변경
RESEND_FROM_EMAIL=mocozi <onboarding@resend.dev>

# ===================================================================
# CORS / 도메인
# ===================================================================
# 프론트엔드 배포 도메인 (로컬 개발: http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# ===================================================================
# 서버 포트
# ===================================================================
PORT=8080
