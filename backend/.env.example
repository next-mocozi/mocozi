# 데이터베이스
# - docker compose 환경: host = db
# - 호스트(로컬)에서 직접 실행: host = localhost
DATABASE_URL=postgresql://mocozi:mocozi_password@db:5432/mocozi_db
# 커넥션 풀러(Supabase/Accelerate) 없이 직접 연결 시 DATABASE_URL과 동일하게 설정
DIRECT_URL=postgresql://mocozi:mocozi_password@db:5432/mocozi_db

# JWT 인증 (운영 시 반드시 강력한 시크릿으로 교체)
JWT_SECRET=your-jwt-secret-key-here

# SMTP 메일 설정 (대학 메일 인증용)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password

# 프론트엔드 URL (CORS 설정)
FRONTEND_URL=http://localhost:3000

# 서버 포트
PORT=8080
