// Prisma 스키마 - 모코지 데이터 모델 정의

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 사용자 모델
model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  lastName          String
  firstName         String
  university        String
  department        String
  grade             String?
  role              String    @default("USER")
  profileImage      String?
  bio               String?
  skills            String[]
  roles             String[] @default([])
  emailVerified     Boolean   @default(false)
  verificationToken       String?
  verificationTokenExpiry DateTime?
  refreshToken            String?
  careerSummary     String?
  bannerColor       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // 관계
  ledTeams       Team[]        @relation("TeamLeader")
  teamMembers    TeamMember[]
  applications   Application[]
  portfolio      Portfolio?

  // 채팅 역참조 (모델 C: ChatRoomMember 도입 + 답글/반응/생성자 관계)
  sentMessages     ChatMessage[]
  chatMemberships  ChatRoomMember[]
  createdChatRooms ChatRoom[]        @relation("CreatedChatRooms")
  reactions        MessageReaction[]

  // 채팅 양식 + 팀 contact 역참조
  messageTemplates UserMessageTemplate[]
  contactedTeams   Team[]                @relation("TeamContact")

  // §B-DM-9 알림 — 받는 사람 입장의 알림 역참조
  notifications Notification[]

  @@map("users")
}

enum TeamType {
  STUDY
  COMPETITION
  HACKATHON
  PROJECT
}

enum ApplicationContactType {
  LEADER     // 팀장 1명에게 DIRECT
  MEMBER     // 지정된 팀원 1명에게 DIRECT
  TEAM_CHAT  // 팀원 전체 GROUP 채팅
}

// 팀 모델
model Team {
  id           String   @id @default(uuid())
  name         String   @unique
  leaderId     String
  teamType     TeamType
  description  String?
  maxMembers   Int?
  isRecruiting Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 지원 받을 사람 라우팅 — 양식 시스템 (Phase A)
  applicationContactType   ApplicationContactType @default(LEADER)
  applicationContactUserId String?

  // 관계
  leader            User         @relation("TeamLeader", fields: [leaderId], references: [id])
  applicationContact User?       @relation("TeamContact", fields: [applicationContactUserId], references: [id])
  members           TeamMember[]
  proposal          TeamProposal?
  applications      Application[]

  @@map("teams")
}

// 팀원 모델
model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  role     String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("team_members")
}

// 팀 기획서 모델 - 필수/선택 공개 정보 분리
model TeamProposal {
  id               String   @id @default(uuid())
  teamId           String   @unique
  projectName      String
  overview         String
  schedule         String
  recruitingRoles  String[]
  requiredSkills   String[]
  referenceLinks   String[] //선택
  detailedPlan     String?
  expectedOutcome  String?
  publicFields     String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@map("team_proposals")
}

// 지원서 모델
model Application {
  id        String            @id @default(uuid())
  teamId    String
  userId    String
  status    ApplicationStatus @default(PENDING)
  message   String
  createdAt DateTime          @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("applications")
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// 스카우트 모델 — Phase B-DM-8에서 폐기.
// B-DM-1 통합 후 /api/scout/* 호출 0건이라 모델·enum·relation 통째 제거.
// 통계 필요 시 chat_rooms.context (SCOUT_FROM_TEAM)로 추적 가능. §19 폐기 결정 참고.

// 포트폴리오 모델
model Portfolio {
  id          String          @id @default(uuid())
  userId      String          @unique
  // 공개/비공개 — true 면 메인 피드에 노출, false 면 owner 만 열람
  isPublic    Boolean         @default(false)
  // 첫 게시 시각 — 메인/내 피드 정렬 기준
  firstPostAt DateTime?
  // 포트폴리오 자기소개 섹션
  intro       String?
  user        User            @relation(fields: [userId], references: [id])
  items       PortfolioItem[]

  // Phase 3 — 부속 메타 (실무경험, 대외활동, 외부 링크)
  // Prisma 양방향 관계 요구로 역참조 3줄 추가. DB에는 컬럼 변경 0건.
  workExperiences PortfolioWorkExperience[]
  activities      PortfolioExternalActivity[]
  links           PortfolioLink[]

  @@map("portfolios")
}

// 포트폴리오 아이템 모델 - 카드 형태
model PortfolioItem {
  id          String            @id @default(uuid())
  portfolioId String
  type        PortfolioItemType
  title       String
  description String
  techStack   String[]
  duration    String
  role        String
  domain      String
  tags        String[]
  createdAt   DateTime          @default(now())

  // 프론트 카드 표시용 추가 필드 (확장)
  summary     String?
  featured    Boolean           @default(false)
  thumbnail   String?
  period      String?
  current     Boolean           @default(false)
  details     Json?             // 인터뷰 답변/에셋 등 type별 상세 데이터
  updatedAt   DateTime          @updatedAt @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id])

  @@map("portfolio_items")
}

enum PortfolioItemType {
  PROJECT
  RESEARCH
  STUDY
  ACTIVITY
  ETC
}

// =====================================================
// Phase 3 — 포트폴리오 부속 메타
// =====================================================

// 포트폴리오 - 실무 경험 (회사·인턴 등)
model PortfolioWorkExperience {
  id          String    @id @default(uuid())
  portfolioId String
  company     String
  team        String?
  role        String
  // "2024.06 - 2024.08" / "2024.06 - 현재" 등 표시용 raw string.
  // 정렬·검색은 Phase 3 범위 외 — 추후 startDate/endDate 컬럼으로 정규화 가능.
  period      String
  current     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("portfolio_work_experiences")
}

// 포트폴리오 - 대외 활동 (수상/수료/발표 등 단발성)
model PortfolioExternalActivity {
  id          String    @id @default(uuid())
  portfolioId String
  year        String    // 4자리 표시용
  month       String?   // "01"~"12" zero-padded, optional (기존 데이터 호환)
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("portfolio_external_activities")
}

// 포트폴리오 - 외부 링크 (GitHub, 블로그 등)
model PortfolioLink {
  id          String    @id @default(uuid())
  portfolioId String
  url         String
  label       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("portfolio_links")
}

// =====================================================
// 그룹 ④ 채팅 (DM / 그룹 / 채널)
// =====================================================

enum ChatRoomType {
  DIRECT    // 1:1 DM
  GROUP     // N명 그룹 DM (Phase A에서 사용)
  CHANNEL   // 채널형 그룹 (Phase B 확장 시 사용)
}

enum ChatRoomMemberRole {
  MEMBER    // 일반 참여자
  ADMIN     // 관리자 (Phase B에서 활성화)
}

// -----------------------------------------------------
// 채팅방
// -----------------------------------------------------
model ChatRoom {
  id            String        @id @default(uuid())
  type          ChatRoomType  @default(DIRECT)

  // GROUP/CHANNEL 전용 (DIRECT면 null)
  name          String?
  description   String?
  creatorId     String?

  // 진입 컨텍스트 — 어떤 페이지/맥락에서 시작된 방인지 (RoomList 색 점 표시용).
  // §17 정책: nullable (옛 방 호환), DIRECT find-or-create 시 첫 값 유지.
  context       MessageContext?

  // 컨텍스트가 가리키는 대상 ID — §B-DM-8 인라인 액션(기획서/프로필 보기)의 fetch 타겟.
  // SCOUT_FROM_TEAM/RECRUIT_TEAM: 팀 ID. RECRUIT_INDIVIDUAL/PORTFOLIO_*: 대상 user ID (DIRECT
  // 상대는 members로 추출되므로 보통 null이어도 됨). 옛 방은 null — 인라인 액션 graceful 숨김.
  contextTargetId String?

  // 마지막 메시지 미리보기 (사이드바 표시용)
  lastMessage   String?
  lastMessageAt DateTime?     // 메시지 수신 시각 — updatedAt과 분리

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt    // 방 메타데이터(이름·설명) 변경 시각

  creator       User?            @relation("CreatedChatRooms", fields: [creatorId], references: [id])
  members       ChatRoomMember[]
  messages      ChatMessage[]

  @@index([type])
  @@index([lastMessageAt])    // 사이드바 최신순 정렬용
  @@map("chat_rooms")
}

// -----------------------------------------------------
// 채팅방-사용자 연결 (멤버십)
// 모델명: ChatRoomUser → ChatRoomMember (의미 명확화)
// -----------------------------------------------------
model ChatRoomMember {
  id                String              @id @default(uuid())
  roomId            String
  userId            String

  role              ChatRoomMemberRole  @default(MEMBER)

  // 읽음 처리: 모델 C — 마지막으로 읽은 메시지 ID
  // 안 읽은 개수 = 이 ID 이후의 메시지 COUNT
  lastReadMessageId String?

  joinedAt          DateTime            @default(now())
  leftAt            DateTime?           // null: 활성 멤버, 값: 나간 멤버 (영구 — 메시지 수신 X)
  hiddenAt          DateTime?           // null: 표시 / 값: 목록에서 숨김 (메시지 수신은 정상, hide 시 자동 mute 정책)
  mutedAt           DateTime?           // null: 알림 받음 / 값: 알림(토스트) X (메시지 데이터는 정상 수신)

  // onDelete: Cascade — 채팅방 삭제 시 멤버십 정리 (안전장치)
  // 다른 모델 컨벤션과 다른 예외. "방 폭파" 시 데이터 무결성 위해 채팅 영역만 적용
  room              ChatRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id])
  lastReadMessage   ChatMessage?        @relation("LastReadByMembers", fields: [lastReadMessageId], references: [id])

  @@unique([roomId, userId])
  @@index([userId])
  @@index([roomId, leftAt])
  @@map("chat_room_members")
}

// -----------------------------------------------------
// 메시지
// -----------------------------------------------------
model ChatMessage {
  id        String      @id @default(uuid())
  roomId    String
  senderId  String
  content   String      @db.Text     // 무제한 길이 (코드 블록 등)

  parentId  String?                  // 답글 (자기참조)
  editedAt  DateTime?                // null: 미수정. 값: "(편집됨)" 표시
  deletedAt DateTime?                // 소프트 삭제. UI는 "삭제된 메시지" placeholder

  createdAt DateTime    @default(now())

  // onDelete: Cascade — 채팅방 삭제 시 메시지 정리 (안전장치)
  // 일반 운영에서는 deletedAt 소프트 삭제만 사용
  room          ChatRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender        User              @relation(fields: [senderId], references: [id])
  parent        ChatMessage?      @relation("MessageReplies", fields: [parentId], references: [id])
  replies       ChatMessage[]     @relation("MessageReplies")
  reactions     MessageReaction[]
  readByMembers ChatRoomMember[]  @relation("LastReadByMembers")

  @@index([roomId, createdAt])     // cursor-based 페이징 핵심 인덱스 (반드시 필요)
  @@index([senderId])
  @@index([parentId])
  @@map("chat_messages")
}

// -----------------------------------------------------
// 메시지 반응 (이모지)
// -----------------------------------------------------
model MessageReaction {
  id        String      @id @default(uuid())
  messageId String
  userId    String
  emoji     String                       // "👍", "❤️" 등
  createdAt DateTime    @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])   // 같은 사람·같은 메시지·같은 이모지 중복 방지
  @@index([messageId])
  @@map("message_reactions")
}

// =====================================================
// 그룹 ⑤ 채팅 양식 (컨텍스트별 첫 메시지 양식)
// =====================================================

enum MessageContext {
  // Phase A
  RECRUIT_INDIVIDUAL          // 개인 → 개인 (recruit 페이지의 "프로필" 경유 채팅)
  RECRUIT_TEAM                // 개인 → 팀 (team 상세에서 합류 의사)
  SCOUT_FROM_TEAM             // 팀 → 개인 (recruit 페이지의 "스카우트" 채팅 통합)

  // Phase B
  PORTFOLIO_COFFEE_CHAT       // 포트폴리오 — 커피챗
  PORTFOLIO_FRIENDSHIP        // 포트폴리오 — 친해지고 싶어요
  PORTFOLIO_INQUIRY           // 포트폴리오 — 문의
  PORTFOLIO_COLLAB            // 포트폴리오 — 협업
  PORTFOLIO_PRAISE            // 포트폴리오 — 칭찬
  COMMUNITY_PRIVATE_NOTE      // 커뮤니티 — 익명 쪽지
  RANDOM_MATCH                // 랜덤 매칭
}

// -----------------------------------------------------
// 사용자별·컨텍스트별 메시지 양식 (Phase A에선 RECRUIT_*만 사용)
// 컨텍스트가 곧 양식의 종류 — 사용자가 별도 라벨링 X
// (userId, context) UNIQUE — 같은 컨텍스트 내 다중 양식 X
// -----------------------------------------------------
model UserMessageTemplate {
  id        String         @id @default(uuid())
  userId    String
  context   MessageContext
  content   String         @db.Text  // {senderName} 등 placeholder 포함 raw text
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, context])
  @@index([userId])
  @@map("user_message_templates")
}

// -----------------------------------------------------
// 알림 — Phase B-DM-9 (§01-decisions.md §23 / 08-phase-b-policy.md B-DM-9)
//
// 사용자별 누적 알림 row. NotificationCenter dropdown이 fetch하고 socket
// `notification:new`로 실시간 도착 시 prepend.
//
// linkTo: 클릭 시 router.push 대상 경로 (예: /chat/<roomId>, /team/<id>/applications)
// readAt: null이면 안 읽음. 클릭 시 read 처리. "read-all" 일괄 처리도 지원.
// -----------------------------------------------------
enum NotificationType {
  /** 스카우트/구인 등 응답 기대 채팅의 첫 메시지 수신 (context 방의 creator → 본인) */
  CHAT_NEW_REQUEST
  /** 본인 팀에 지원자 들어옴 (team leader 받음) */
  APPLICATION_RECEIVED
  /** 본인 지원이 ACCEPTED/REJECTED 처리됨 (applicant 받음) */
  APPLICATION_PROCESSED
  // 후속 카테고리 자리 — CHAT_REPLY, CHAT_EXPIRED, TEAM_MEMBER_CHANGED 등
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           // 받는 사람
  type      NotificationType
  title     String           // "○○님이 스카우트 메시지를 보냈습니다"
  body      String?          @db.Text  // 부가 설명 (옵션)
  linkTo    String?          // 클릭 시 이동할 경로
  readAt    DateTime?        // null=안 읽음
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}
